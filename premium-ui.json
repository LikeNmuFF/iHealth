{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "en-PH",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Date",
    "Form",
    "Scrollbar",
    "Toast",
    "CRUD"
  ],
  "ownership": { "Select/Listbox": "native", "Date": "native" },
  "requiredCommands": ["unit", "e2e", "typecheck", "lint", "build"],
  "commands": {
    "unit": "npm test",
    "e2e": "npm run test:e2e",
    "typecheck": "npm run typecheck",
    "lint": "npm run lint",
    "build": "npm run build"
  },
  "evidence": {
    "crudFullFlow": "tests/e2e/demo.spec.ts",
    "failurePaths": "tests/domain.test.ts"
  }
}
