# Optional. Default uses standard OSM tiles with browser caching and attribution.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION="© <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap contributors</a>"
# Default: public OSRM service for low-volume, non-commercial demos (no API key).
# Policy: https://github.com/Project-OSRM/osrm-backend/wiki/Demo-server
# Override with your own authorized OSRM-compatible service for sustained use.
# Browser-public URL, no secrets. Server must allow CORS.
NEXT_PUBLIC_OSRM_ENDPOINT=https://router.project-osrm.org
# Adapter uses driving only; server must be built with the car/driving profile.
